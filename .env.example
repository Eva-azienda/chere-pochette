# Copy this file to ".env" (never commit .env — it is in .gitignore) to run the Zahls sync locally:
#   node scripts/zahls-sync.mjs --check   only tests the connection (instance + API key)
#   npm run zahls:sync                    the sync (DRY_RUN=1 first!)
# The sync obeys "checkout": { "enabled": … } in src/data/site.json: while it is not true, the sync
# only tests the connection and prints what it would do — it never creates links or changes files.
# On GitHub the same values come from Settings → Secrets and variables → Actions.

# Instance name: the "xyz" in https://xyz.zahls.ch (Zahls dashboard → API & Integration)
ZAHLS_INSTANCE=

# API secret of that instance (Zahls dashboard → API & Integration). Keep it secret!
ZAHLS_API_KEY=

# Public address of the site, used for the "thank you" / "payment cancelled" redirects.
# Origin only (no path), e.g. https://eva-azienda.github.io or https://www.cherepochette.ch
# (only needed when checkout is enabled)
SITE_URL=https://example.github.io

# Base path of the site: "/<repository-name>/" on a GitHub Pages project site, "/" with a custom domain.
BASE_PATH=/

# 1 = only read from Zahls and print what would happen; nothing is created, deleted or written.
DRY_RUN=1

# 1 = replace the payment links of every available bag (e.g. after SITE_URL / BASE_PATH changed).
RECREATE_LINKS=
