---
/**
 * Home page – one file for all languages: / (it), /de/, /en/.
 * Sections, in this order: hero (bag + short headline + one button), the bags on sale (grid with
 * prices), the marquee band, one short story block (materials + the Ukrainian women → /about/),
 * the team strip (group photo → /team/), Instagram.
 * The detail (process, models, values) lives on the dedicated pages, not here.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BagSketch from '../../components/BagSketch.astro';
import BrandPicture from '../../components/BrandPicture.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import ThreadDivider from '../../components/ThreadDivider.astro';
import bagHands from '../../assets/brand/hero-bag-hands.jpg';
import { localeStaticPaths, useTranslations, type Lang } from '../../lib/i18n';
import { localePath } from '../../lib/urls';
import { getAvailableProducts, site } from '../../lib/catalog';
import { teamGroupPhoto } from '../../lib/team-photos';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.props as { lang: Lang };
const { t, list, pageMeta } = useTranslations(lang);

// Up to 6 bags. From 64rem: 4 columns, or 3 when that fills the rows better (3, 5 or 6 bags).
const featured = (await getAvailableProducts()).slice(0, 6);
const threeColumns = featured.length === 3 || featured.length >= 5;
const cardSizes = threeColumns
  ? '(min-width: 72rem) 22rem, (min-width: 64rem) 30vw, 46vw'
  : '(min-width: 72rem) 16rem, (min-width: 64rem) 22vw, 46vw';

const marquee = list('home.hero.marquee');
// "https://www.instagram.com/chere.pochette/" → "@chere.pochette"
const instagramHandle = `@${site.instagram.match(/instagram\.com\/([^/?#]+)/)?.[1] ?? 'chere.pochette'}`;
---

<BaseLayout lang={lang} path="" {...pageMeta('home')}>
  <!-- ========== Hero ==========
       Phones: the bag on its powder circle, the headline, one sentence and one button – all
       above the fold (the drawing's size follows the screen height, the notes are hidden).
       From 64rem: text on the left, the large bag with its notes on the right. -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__inner container">
      <div class="hero__art">
        <BagSketch lang={lang} />
      </div>
      <div class="hero__text">
        <h1 id="hero-title" class="hero__title">{t('home.hero.title')}</h1>
        <p class="hero__lead">{t('home.hero.lead')}</p>
        <a class="btn btn--primary hero__cta" href={localePath(lang, 'shop/')}>{t('home.hero.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ========== Bags on sale ==========
       A grid (never a carousel): 2 columns on phones, 3–4 from 64rem. Photo, name and price on every card. -->
  <section class="section featured" aria-labelledby="featured-title">
    <div class="container">
      <div class="heading featured__heading">
        <p class="eyebrow">{t('home.featured.eyebrow')}</p>
        <h2 id="featured-title">{t('home.featured.title')}</h2>
        <p>{t('home.featured.text')}</p>
      </div>

      {
        featured.length > 0 ? (
          <>
            <ul role="list" class:list={['product-grid', { 'featured__grid--3': threeColumns }]}>
              {featured.map((product) => (
                <li>
                  <ProductCard product={product} lang={lang} sizes={cardSizes} />
                </li>
              ))}
            </ul>
            <div class="featured__more">
              <a class="btn btn--outline" href={localePath(lang, 'shop/')}>{t('home.featured.cta')}</a>
            </div>
          </>
        ) : (
          <div class="empty">
            <ThreadDivider />
            <p class="lead">{t('home.featured.empty')}</p>
            <a class="btn btn--outline" href={site.instagram} rel="noopener">
              <Icon name="instagram" size={20} />
              {t('common.followInstagram')}
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- A slow band of the four promises, between the bags and the story. Decorative: the same
       words are on the page as text, so screen readers skip it. -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {
        [0, 1].map(() => (
          <ul role="list" class="marquee__group">
            {marquee.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <!-- ========== Story: recovered materials + the women who crochet with us ==========
       The photo of a bag held against the body also shows its size.
       Phones: photo above the text. From 48rem: text left, photo right. -->
  <section class="section story" aria-labelledby="story-title">
    <div class="container feature feature--reverse">
      <div class="feature__media media story__media">
        <BrandPicture
          src={bagHands}
          alt={t('images.heroBagHands')}
          sizes="(min-width: 72rem) 34rem, (min-width: 48rem) 45vw, 100vw"
          widths={[480, 768, 1080, 1440]}
          position="45% 55%"
        />
      </div>
      <div class="feature__text stack story__text">
        <p class="eyebrow">{t('home.story.eyebrow')}</p>
        <h2 id="story-title">{t('home.story.title')}</h2>
        <p>{t('home.story.text')}</p>
        <a class="link-arrow" href={localePath(lang, 'about/')}>{t('home.story.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ========== The team (compact strip) ==========
       Phones: the group photo, then the text. From 48rem: photo left, text right.
       Photo: src/assets/team/group.jpg -->
  <section class="section section--alt team-strip" aria-labelledby="team-title">
    <div class="container team-strip__inner">
      {
        teamGroupPhoto && (
          <div class="media team-strip__media">
            <BrandPicture
              src={teamGroupPhoto}
              alt={t('images.teamGroup')}
              sizes="(min-width: 48rem) 26rem, 100vw"
              widths={[480, 768, 900]}
            />
          </div>
        )
      }
      <div class="team-strip__text">
        <p class="eyebrow">{t('home.team.eyebrow')}</p>
        <h2 id="team-title" class="h3">{t('home.team.title')}</h2>
        <p>{t('home.team.text')}</p>
        <a class="link-arrow" href={localePath(lang, 'team/')}>{t('home.team.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ========== Instagram ==========
       A plain link to the profile: no embedded feed and no third-party script (privacy). -->
  <section class="section section--powder social" aria-labelledby="social-title">
    <div class="container container--narrow social__inner">
      <span class="social__icon"><Icon name="instagram" size={28} /></span>
      <p class="eyebrow">{t('home.social.eyebrow')}</p>
      <h2 id="social-title" class="social__handle">{instagramHandle}</h2>
      <p class="social__text">{t('home.social.text')}</p>
      <a class="btn btn--primary" href={site.instagram} rel="noopener">
        <Icon name="instagram" size={20} />
        {t('common.followInstagram')}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ----------
     Phones: bag, headline, one sentence, one button – centred and tight, so all four fit on the
     first screen. The drawing's width follows the screen height (svh): on short phones it gets a
     little smaller instead of pushing the button below the fold.
     From 48rem: more air and the notes; from 64rem: two columns. */
  .hero {
    /* 96vw at most (powder circle ≈ 73% of the width); the rest of the screen height is kept for
       header (62px), headline, sentence and button (≈ 20.5rem in the longest language). */
    --art-w: clamp(13rem, (100svh - 20.5rem) * 1.04, min(96vw, 26rem));
    padding-block: var(--s-2) var(--s-6);
  }

  .hero__inner {
    display: grid;
    justify-items: center;
    gap: var(--s-3);
  }

  .hero__art {
    width: var(--art-w);
    /* may be a little wider than the text column: equal negative margins keep it centred */
    margin-inline: calc((100% - var(--art-w)) / 2);
    /* the strip under the needle is only for the bottom note, hidden on phones */
    margin-bottom: calc(var(--art-w) * -0.1);
  }

  .hero__text {
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    max-width: 34rem;
    text-align: center;
  }

  .hero__title {
    max-width: 15em;
    font-size: clamp(1.625rem, 1.1rem + 2.6vw, 3.5rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  .hero__lead {
    max-width: 30em;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--c-anthracite);
  }

  .hero__cta {
    width: min(100%, 20rem);
    margin-top: var(--s-2);
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--s-6) var(--s-7);
    }

    .hero__inner {
      gap: var(--s-5);
    }

    /* the notes are back: room above for the top one, below for the bottom one */
    .hero__art {
      width: min(56vw, 26rem);
      margin: var(--s-6) 0 var(--s-7);
    }

    .hero__text {
      gap: var(--s-4);
    }

    .hero__lead {
      font-size: var(--fs-lg);
      line-height: 1.5;
    }

    .hero__cta {
      width: auto;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-block: var(--s-6);
    }

    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      column-gap: var(--s-7);
    }

    /* left-aligned in its column, so the notes on the right of the drawing have room */
    .hero__art {
      order: 2;
      width: min(78%, 34rem, 60svh);
      margin-block: 0;
      justify-self: start;
    }

    .hero__text {
      justify-items: start;
      gap: var(--s-5);
      max-width: 30rem;
      text-align: left;
    }

    .hero__cta {
      margin-top: 0;
    }
  }

  @media (min-width: 80rem) {
    /* large screens: the drawing takes the wider column */
    .hero__inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .hero__art {
      width: min(82%, 34rem, 60svh);
    }
  }

  /* ---------- Bags on sale ---------- */
  .featured {
    padding-top: var(--s-6);
  }

  .featured__heading {
    margin-bottom: var(--s-5);
  }

  /* phones: a little less space between the rows of cards */
  .featured .product-grid {
    row-gap: var(--s-5);
  }

  @media (min-width: 64rem) {
    .featured {
      padding-top: var(--s-7);
    }

    .featured .product-grid {
      row-gap: var(--s-7);
    }

    .featured .featured__grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .featured__more {
    display: flex;
    justify-content: center;
    margin-top: var(--s-6);
  }

  .featured__more .btn {
    width: min(100%, 20rem);
  }

  /* ---------- Marquee band ---------- */
  .marquee {
    overflow: hidden;
    background: var(--c-bordeaux);
    color: var(--c-ivory);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
  }

  .marquee__group {
    display: flex;
    flex-shrink: 0;
  }

  .marquee__group li {
    display: flex;
    align-items: center;
    padding-block: var(--s-3);
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-lg);
    line-height: 1.6;
    white-space: nowrap;
  }

  /* a small stitch between the words */
  .marquee__group li::after {
    content: '';
    width: 0.4em;
    height: 0.4em;
    margin-inline: 1.4em;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.7;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }

  /* ---------- Story ----------
     Phones: a compact landscape photo (3:2) above the text. From 48rem: 4:3 next to the text. */
  .feature__media.story__media {
    aspect-ratio: 3 / 2;
  }

  @media (min-width: 48rem) {
    .feature__media.story__media {
      aspect-ratio: 4 / 3;
    }

    .story__text {
      max-width: 30rem;
    }
  }

  /* ---------- Team strip ---------- */
  .team-strip {
    padding-block: var(--s-7);
  }

  .team-strip__inner {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }

  /* Phones: a wide 16:9 crop (the faces are in the upper part), so the strip stays short.
     From 48rem: the group photo's own shape (900 × 630). */
  .team-strip__media {
    aspect-ratio: 16 / 9;
  }

  .team-strip__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .team-strip__text {
    display: grid;
    justify-items: start;
    gap: var(--s-2);
    max-width: 32rem;
  }

  .team-strip__text .link-arrow {
    margin-top: calc(var(--s-1) * -1);
  }

  @media (min-width: 48rem) {
    .team-strip__inner {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: var(--s-7);
    }

    .team-strip__media {
      aspect-ratio: 900 / 630;
    }
  }

  /* ---------- Instagram ---------- */
  .social__inner {
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    text-align: center;
  }

  .social__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--s-1);
    border-radius: 50%;
    background: var(--c-ivory);
    color: var(--c-bordeaux);
  }

  .social__handle {
    font-size: var(--fs-2xl);
    font-style: italic;
    overflow-wrap: anywhere;
  }

  .social__text {
    max-width: 28rem;
    color: var(--c-anthracite);
  }

  .social .btn {
    width: min(100%, 20rem);
    margin-top: var(--s-3);
  }

  @media (min-width: 48rem) {
    .social .btn {
      width: auto;
    }
  }
</style>
