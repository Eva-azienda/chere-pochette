---
/**
 * Home page – one file for all languages: / (it), /de/, /en/.
 * Sections: hero, concept + 3 pillars, bags in the shop, the 3 models, process teaser,
 * story teaser (the Ukrainian women), the team (group photo), newsletter.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtPicture from '../../components/ArtPicture.astro';
import BagSketch from '../../components/BagSketch.astro';
import BrandPicture from '../../components/BrandPicture.astro';
import Icon from '../../components/Icon.astro';
import ModelsShowcase from '../../components/ModelsShowcase.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import ProductCard from '../../components/ProductCard.astro';
import ThreadDivider from '../../components/ThreadDivider.astro';
import umbrellaFabrics from '../../assets/brand/umbrellas-fabrics.jpg';
import womenLandscape from '../../assets/brand/women-crochet.jpg';
import womenPortrait from '../../assets/brand/women-crochet-45.jpg';
import { localeStaticPaths, useTranslations, type Lang } from '../../lib/i18n';
import { localePath } from '../../lib/urls';
import { getAvailableProducts, site } from '../../lib/catalog';
import { teamGroupPhoto } from '../../lib/team-photos';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.props as { lang: Lang };
const { t, list, pageMeta } = useTranslations(lang);
const featured = (await getAvailableProducts()).slice(0, 4);
const pillars = list<{ id: 'reuse' | 'handmade' | 'together'; title: string; text: string }>('home.pillars.items');
const steps = list<{ id: string; title: string }>('process.steps');
const marquee = list('home.hero.marquee');
---

<BaseLayout lang={lang} path="" {...pageMeta('home')} footerNewsletter={false}>
  <!-- ========== Hero ==========
       Phones: the annotated sketch, the headline (in the page's language) and one button.
       From 64rem: text on the left, the large annotated sketch on the right. -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__inner container">
      <div class="hero__art">
        <BagSketch lang={lang} />
      </div>
      <div class="hero__text">
        <h1 id="hero-title" class="hero__title">{t('home.hero.subtitle')}</h1>
        <!-- The English tagline as a small quote. -->
        <blockquote class="hero__quote" lang={lang === 'en' ? undefined : 'en'}>
          <p>{t('brand.tagline')}</p>
        </blockquote>
        <div class="hero__actions">
          <a class="btn btn--primary" href={localePath(lang, 'shop/')}>{t('home.hero.cta')}</a>
          <a class="link-arrow hero__secondary" href={localePath(lang, 'about/')}>{t('home.hero.ctaSecondary')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- A slow band of the four promises, between the hero and the concept. Decorative: the same
       words are on the page as text, so screen readers skip it. -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {
        [0, 1].map(() => (
          <ul role="list" class="marquee__group">
            {marquee.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <!-- ========== Concept + 3 pillars ========== -->
  <section class="section section--alt" aria-labelledby="intro-title">
    <div class="container">
      <div class="heading center">
        <p class="eyebrow">{t('home.intro.eyebrow')}</p>
        <h2 id="intro-title">{t('home.intro.title')}</h2>
        <p class="lead">{t('home.intro.text')}</p>
      </div>
      <ThreadDivider class="intro__thread" />
      <h3 class="pillars__title tagline center">{t('home.pillars.title')}</h3>
      <ul role="list" class="pillars">
        {
          pillars.map((pillar) => (
            <li class="pillar">
              <span class="pillar__icon">
                <Icon name={pillar.id} size={52} />
              </span>
              <h4 class="pillar__title">{pillar.title}</h4>
              <p>{pillar.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ========== Bags in the shop ========== -->
  <section class="section" aria-labelledby="featured-title">
    <div class="container">
      <div class="split-heading">
        <div class="heading">
          <p class="eyebrow">{t('home.featured.eyebrow')}</p>
          <h2 id="featured-title">{t('home.featured.title')}</h2>
          <p>{t('home.featured.text')}</p>
        </div>
        {featured.length > 0 && <a class="link-arrow" href={localePath(lang, 'shop/')}>{t('home.featured.cta')}</a>}
      </div>

      {
        featured.length > 0 ? (
          <ul role="list" class="product-grid">
            {featured.map((product) => (
              <li>
                <ProductCard product={product} lang={lang} />
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty">
            <ThreadDivider />
            <p class="lead">{t('home.featured.empty')}</p>
            <a class="btn btn--outline" href={site.instagram} rel="noopener">
              <Icon name="instagram" size={20} />
              {t('common.followInstagram')}
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- ========== The three models ========== -->
  <section class="section section--tight" aria-labelledby="models-title">
    <div class="container">
      <div class="heading center">
        <p class="eyebrow">{t('home.models.eyebrow')}</p>
        <h2 id="models-title">{t('home.models.title')}</h2>
        <p>{t('home.models.text')}</p>
      </div>
      <ModelsShowcase lang={lang} />
    </div>
  </section>

  <!-- ========== Process teaser ========== -->
  <section class="section section--alt" aria-labelledby="process-title">
    <div class="container feature">
      <div class="feature__media media">
        <BrandPicture
          src={umbrellaFabrics}
          alt={t('images.umbrellasFabrics')}
          sizes="(min-width: 48rem) 45vw, 100vw"
          widths={[480, 768, 1080, 1440]}
        />
      </div>
      <div class="feature__text stack">
        <p class="eyebrow">{t('home.process.eyebrow')}</p>
        <h2 id="process-title">{t('home.process.title')}</h2>
        <p>{t('home.process.text')}</p>
        <ol class="steps-inline" role="list">
          {
            steps.map((step, i) => (
              <li>
                <span class="steps-inline__n">{String(i + 1).padStart(2, '0')}</span>
                {step.title}
              </li>
            ))
          }
        </ol>
        <a class="link-arrow" href={localePath(lang, 'process/')}>{t('home.process.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ========== Story teaser ========== -->
  <section class="section" aria-labelledby="story-title">
    <div class="container feature feature--reverse">
      <div class="feature__media media story__media">
        <ArtPicture
          mobile={womenPortrait}
          desktop={womenLandscape}
          alt={t('images.womenCrochet')}
          mobileSizes="100vw"
          desktopSizes="50vw"
          mobilePosition="50% 40%"
          desktopPosition="50% 45%"
        />
      </div>
      <div class="feature__text stack">
        <p class="eyebrow">{t('home.story.eyebrow')}</p>
        <h2 id="story-title">{t('home.story.title')}</h2>
        <p>{t('home.story.text')}</p>
        <div class="story__actions">
          <a class="btn btn--primary" href={localePath(lang, 'about/')}>{t('home.story.cta')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== The team ==========
       Phones: the group photo (full width, rounded corners), then the text.
       From 48rem: photo left, text right. Photo: src/assets/team/group.jpg -->
  <section class="section section--alt" aria-labelledby="team-title">
    <div class="container feature">
      {
        teamGroupPhoto && (
          <div class="feature__media media team__media">
            <BrandPicture
              src={teamGroupPhoto}
              alt={t('images.teamGroup')}
              sizes="(min-width: 72rem) 34rem, (min-width: 48rem) 45vw, 100vw"
              widths={[480, 768, 900]}
            />
          </div>
        )
      }
      <div class="feature__text stack">
        <p class="eyebrow">{t('home.team.eyebrow')}</p>
        <h2 id="team-title">{t('home.team.title')}</h2>
        <p>{t('home.team.text')}</p>
        <div>
          <a class="btn btn--outline" href={localePath(lang, 'team/')}>{t('home.team.cta')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== Newsletter + Instagram ========== -->
  <section class="section section--powder" aria-labelledby="newsletter-title">
    <div class="container container--narrow newsletter center">
      <ThreadDivider />
      <h2 id="newsletter-title">{t('home.newsletter.title')}</h2>
      <p>{t('home.newsletter.text')}</p>
      <NewsletterForm lang={lang} id="home-nl" />
      <p class="newsletter__social">
        {t('home.social.text')}
        <a class="link-arrow" href={site.instagram} rel="noopener">{t('home.social.cta')}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ----------
     Phones: sketch, title, one sentence, one button, centred, with plenty of air.
     From 64rem: two columns, text left, the sketch (with its notes) right. */
  .hero {
    padding-block: var(--s-6) var(--s-8);
  }

  .hero__inner {
    display: grid;
    justify-items: center;
    gap: var(--s-6);
  }

  /* Phones: the drawing gets most of the width; it sits a little left of centre so the side
     note has room on the right, and leaves space below for the bottom note. */
  .hero__art {
    width: min(80vw, 20rem);
    margin-top: var(--s-4);
    margin-bottom: var(--s-2);
    translate: calc(var(--s-4) * -1) 0;
  }

  .hero__text {
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    max-width: 34rem;
    text-align: center;
  }

  .hero__title {
    max-width: 17em;
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 2rem);
    line-height: 1.18;
    letter-spacing: -0.01em;
  }

  /* The English tagline: small italic Bodoni under a bordeaux opening quote mark. */
  .hero__quote {
    max-width: 17em;
    margin: 0;
    font-family: var(--f-display);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.3125rem);
    font-style: italic;
    line-height: 1.25;
    color: var(--c-plum);
    text-wrap: balance;
  }

  .hero__quote::before {
    content: '\201C' / '';
    display: block;
    height: 0.36em;
    font-size: 5em;
    font-variation-settings: 'opsz' 96; /* the fine display cut: teardrops, not dots */
    line-height: 1;
    color: var(--c-bordeaux);
  }

  /* Phones: the drawing gets the space instead. */
  @media (max-width: 47.999rem) {
    .hero__quote {
      display: none;
    }
  }

  .hero__actions {
    display: grid;
    justify-items: center;
    gap: var(--s-1);
    width: min(100%, 20rem);
  }

  .hero__actions .btn {
    width: 100%;
  }

  .hero__actions a {
    white-space: nowrap;
  }

  /* Phones: one clear action. The story is one tap away in the menu and further down. */
  .hero__secondary {
    display: none;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--s-7) var(--s-9);
    }

    .hero__art {
      width: min(56vw, 26rem);
      margin-block: var(--s-6) var(--s-5);
      translate: none;
    }

    .hero__actions {
      display: flex;
      align-items: center;
      gap: var(--s-6);
      width: auto;
    }

    .hero__actions .btn {
      width: auto;
    }

    .hero__secondary {
      display: inline-flex;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      display: flex;
      align-items: center;
      min-height: min(calc(100svh - var(--header-h) - 3.25rem), 50rem);
      padding-block: var(--s-7);
    }

    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      column-gap: var(--s-7);
    }

    /* left-aligned in its column, so the notes on the right of the drawing have room */
    .hero__art {
      order: 2;
      width: min(78%, 40rem, 70svh);
      margin-block: 0;
      justify-self: start;
    }

    .hero__text {
      justify-items: start;
      gap: var(--s-5);
      max-width: 28rem;
      text-align: left;
    }
  }

  @media (min-width: 80rem) {
    /* large screens: the drawing takes the wider column */
    .hero__inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .hero__art {
      width: min(82%, 40rem, 70svh);
    }
  }

  /* ---------- Marquee band ---------- */
  .marquee {
    overflow: hidden;
    background: var(--c-bordeaux);
    color: var(--c-ivory);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
  }

  .marquee__group {
    display: flex;
    flex-shrink: 0;
  }

  .marquee__group li {
    display: flex;
    align-items: center;
    padding-block: var(--s-3);
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-lg);
    line-height: 1.6;
    white-space: nowrap;
  }

  /* a small stitch between the words */
  .marquee__group li::after {
    content: '';
    width: 0.4em;
    height: 0.4em;
    margin-inline: 1.4em;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.7;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }

  /* ---------- Pillars ----------
     Phones: compact rows (small icon left, text right) separated by hairlines.
     From 48rem: three equal centred columns; subgrid lines up icon, title and text. */
  .pillars__title {
    margin-top: var(--s-5);
    margin-bottom: var(--s-5);
  }

  .pillars {
    display: grid;
    max-width: 62rem;
    margin-inline: auto;
    border-top: 1px solid var(--c-line);
  }

  .pillar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--s-4);
    row-gap: var(--s-1);
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--c-line);
  }

  .pillar__icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--c-ivory);
    color: var(--c-bordeaux);
  }

  .pillar__icon :global(svg) {
    width: 32px;
    height: 32px;
  }

  .pillar__title {
    font-size: var(--fs-lg);
  }

  .pillar p {
    font-size: var(--fs-sm);
    color: var(--c-anthracite);
  }

  @media (min-width: 48rem) {
    .pillars__title {
      margin-top: var(--s-6);
      margin-bottom: var(--s-7);
    }

    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: repeat(3, auto);
      align-items: start;
      column-gap: var(--s-6);
      row-gap: 0;
      border-top: 0;
    }

    .pillar {
      grid-row: span 3;
      grid-template-columns: none;
      grid-template-rows: subgrid;
      justify-items: center;
      row-gap: var(--s-4);
      padding-block: 0;
      border-bottom: 0;
      text-align: center;
    }

    .pillar__icon {
      grid-row: auto;
      width: 5.5rem;
      height: 5.5rem;
      margin-bottom: var(--s-1);
    }

    .pillar__icon :global(svg) {
      width: 52px;
      height: 52px;
    }

    .pillar p {
      max-width: 22rem;
      font-size: var(--fs-base);
    }
  }

  /* Phones: the home page reads top to bottom on the left edge (only hero and newsletter are
     centred), and photos are landscape so they don't fill a whole screen each. */
  @media (max-width: 47.999rem) {
    .heading.center {
      justify-items: start;
      text-align: left;
    }

    .heading.center p {
      margin-inline: 0;
    }

    .pillars__title {
      text-align: left;
    }

    .container :global(.intro__thread) {
      display: none;
    }

    .feature {
      gap: var(--s-5);
    }

    .feature__media,
    .story__media {
      aspect-ratio: 4 / 3;
    }
  }

  @media (min-width: 48rem) {
    .story__media {
      aspect-ratio: 3 / 2;
    }
  }

  /* the group photo keeps its own landscape shape (900 × 630) at every size */
  .feature__media.team__media {
    aspect-ratio: 900 / 630;
    border-radius: var(--radius);
  }

  .story__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-6);
  }

  .steps-inline {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--c-line);
  }

  .steps-inline li {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--c-line);
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--c-plum);
  }

  .steps-inline__n {
    font-family: var(--f-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--c-bordeaux);
  }

  /* ---------- Newsletter ---------- */
  .newsletter {
    display: grid;
    justify-items: center;
    gap: var(--s-4);
  }

  .newsletter :global(form) {
    width: 100%;
    text-align: left;
  }

  .newsletter__social {
    display: grid;
    justify-items: center;
    gap: 0;
    margin-top: var(--s-4);
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }
</style>
