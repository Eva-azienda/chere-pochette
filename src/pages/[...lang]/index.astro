---
/** Home page shared by the Italian, German and English routes. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtPicture from '../../components/ArtPicture.astro';
import BrandPicture from '../../components/BrandPicture.astro';
import Icon from '../../components/Icon.astro';
import ModelsShowcase from '../../components/ModelsShowcase.astro';
import heroLogo from '../../assets/brand/logo-home-ufficiale.png';
import bagUmbrella from '../../assets/brand/hero-bag-umbrella-45.jpg';
import womenLandscape from '../../assets/brand/women-crochet.jpg';
import womenPortrait from '../../assets/brand/women-crochet-45.jpg';
import { localeStaticPaths, useTranslations, type Lang } from '../../lib/i18n';
import { localePath } from '../../lib/urls';
import { site } from '../../lib/catalog';
import { teamGroupPhoto } from '../../lib/team-photos';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.props as { lang: Lang };
const { t, list, pageMeta } = useTranslations(lang);

const steps = list<{ title: string }>('process.steps');
// "https://www.instagram.com/chere.pochette/" → "@chere.pochette"
const instagramHandle = `@${site.instagram.match(/instagram\.com\/([^/?#]+)/)?.[1] ?? 'chere.pochette'}`;
---

<BaseLayout lang={lang} path="" {...pageMeta('home')}>
  <!-- ========== Hero ==========
       Official Chère Pochette logo on an ivory background, centered on the first screen.
       The original logo includes the needle, thread and “Made to carry on” slogan;
       no editorial photo or duplicate slogan is shown. The header stays unchanged. -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__inner container">
      <h1 id="hero-title" class="visually-hidden">Chère Pochette</h1>
      <img
        class="hero__logo"
        src={heroLogo.src}
        alt="Chère Pochette — Made to carry on"
        width={heroLogo.width}
        height={heroLogo.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero__product">
        <p>{t('home.hero.product')}</p>
      </div>
      <div class="hero__values" aria-labelledby="hero-values-title">
        <h2 id="hero-values-title">{t('home.hero.values.title')}</h2>
        <p>{t('home.hero.values.text')}</p>
      </div>
      <a class="btn btn--primary hero__cta" href={localePath(lang, 'shop/')}>{t('home.hero.cta')}</a>
    </div>
  </section>

  <ModelsShowcase lang={lang} />

  <!-- ========== The concept ==========
       Two sentences, no picture: outside a garment, inside an umbrella. -->
  <section class="section section--alt concept" aria-labelledby="concept-title">
    <div class="container container--narrow heading center concept__inner">
      <p class="eyebrow">{t('home.concept.eyebrow')}</p>
      <h2 id="concept-title">{t('home.concept.title')}</h2>
      <p class="lead">{t('home.concept.text')}</p>
    </div>
  </section>

  <!-- ========== How a bag is made ==========
       A real photo of a crocheted bag on umbrella fabric, the five steps, link to /process/
       (the recovered-material photos are on that page). From 48rem: photo right. -->
  <section class="section section--alt process-teaser" aria-labelledby="process-title">
    <div class="container feature feature--reverse">
      <div class="feature__media media">
        <BrandPicture
          src={bagUmbrella}
          alt={t('images.heroBagUmbrella')}
          sizes="(min-width: 72rem) 34rem, (min-width: 48rem) 45vw, calc(100vw - 2rem)"
          widths={[480, 768, 1080, 1440]}
          position="50% 60%"
        />
      </div>
      <div class="feature__text stack">
        <p class="eyebrow">{t('home.process.eyebrow')}</p>
        <h2 id="process-title">{t('home.process.title')}</h2>
        <p>{t('home.process.text')}</p>
        <ol role="list" class="steps-inline">
          {
            steps.map((step, i) => (
              <li>
                <span class="steps-inline__n">{String(i + 1).padStart(2, '0')}</span>
                {step.title}
              </li>
            ))
          }
        </ol>
        <a class="link-arrow" href={localePath(lang, 'process/')}>{t('home.process.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ========== Interwoven stories: the multicultural crochet team ==========
       Real photo: women-crochet.jpg (landscape) above the text on phones, its 4:5 crop
       women-crochet-45.jpg on the left from 48rem. -->
  <section class="section story" aria-labelledby="story-title">
    <div class="container feature">
      <div class="feature__media media">
        <ArtPicture
          mobile={womenLandscape}
          desktop={womenPortrait}
          alt={t('images.womenCrochet')}
          mobileSizes="calc(100vw - 2rem)"
          desktopSizes="(min-width: 72rem) 34rem, 45vw"
          mobilePosition="50% 45%"
          desktopPosition="50% 40%"
        />
      </div>
      <div class="feature__text stack">
        <p class="eyebrow">{t('home.story.eyebrow')}</p>
        <h2 id="story-title">{t('home.story.title')}</h2>
        <p>{t('home.story.text')}</p>
        <a class="link-arrow" href={localePath(lang, 'about/')}>{t('home.story.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ========== The team (compact strip) ==========
       Real group photo (src/assets/team/group.jpg). Phones: photo, then text. From 48rem: photo left. -->
  <section class="section section--alt team-strip" aria-labelledby="team-title">
    <div class="container team-strip__inner">
      {
        teamGroupPhoto && (
          <div class="media team-strip__media">
            <BrandPicture
              src={teamGroupPhoto}
              alt={t('images.teamGroup')}
              sizes="(min-width: 48rem) 26rem, calc(100vw - 2rem)"
              widths={[480, 768, 900]}
            />
          </div>
        )
      }
      <div class="team-strip__text">
        <p class="eyebrow">{t('home.team.eyebrow')}</p>
        <h2 id="team-title" class="h3">{t('home.team.title')}</h2>
        <p>{t('home.team.text')}</p>
        <a class="link-arrow" href={localePath(lang, 'team/')}>{t('home.team.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ========== Instagram ==========
       A plain link to the profile: no embedded feed and no third-party script (privacy). -->
  <section class="section section--powder social" aria-labelledby="social-title">
    <div class="container container--narrow social__inner">
      <span class="social__icon"><Icon name="instagram" size={28} /></span>
      <p class="eyebrow">{t('home.social.eyebrow')}</p>
      <h2 id="social-title" class="social__handle">{instagramHandle}</h2>
      <p class="social__text">{t('home.social.text')}</p>
      <a class="btn btn--primary" href={site.instagram} rel="noopener">
        <Icon name="instagram" size={20} />
        {t('common.followInstagram')}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ----------
     Original logo (untouched), product description, then brochure's values.
     The logo's background is #FAF7F2; new lettering uses its ink colour.
     Bodoni LF is preferred when installed; the site's self-hosted Bodoni Moda
     serves as a close substitute where the proprietary face isn't available. */
  .hero {
    background: var(--c-ivory);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 2.3svh, 1.875rem);
    min-height: max(30rem, calc(100svh - var(--header-h)));
    padding-block: clamp(1.5rem, 4svh, 3rem);
    text-align: center;
  }

  .hero__logo {
    display: block;
    width: min(100%, 38rem);
    height: auto;
  }

  /* The product is introduced directly below the original brand logo. */
  .hero__product {
    width: min(100%, 48rem);
  }

  .hero__product p {
    max-width: 45rem;
    margin-inline: auto;
    font-family: 'Bodoni LF', 'Bodoni FLF', var(--f-display);
    font-weight: 400;
    font-size: clamp(1.1875rem, 1.01rem + 0.52vw, 1.5rem);
    line-height: 1.43;
    text-wrap: pretty;
    color: var(--c-logo-ink);
  }

  /* Separate the values section visually from the product introduction. */
  .hero__values {
    width: min(100%, 48rem);
    margin-top: clamp(2.5rem, 6svh, 5rem);
    color: var(--c-logo-ink);
  }

  .hero__values h2 {
    font-family: 'Bodoni LF', 'Bodoni FLF', var(--f-display);
    font-weight: 400;
    font-size: clamp(2rem, 1.65rem + 1.45vw, 2.8rem);
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: inherit;
  }

  .hero__values p {
    max-width: 47rem;
    margin: var(--s-3) auto 0;
    font-family: 'Bodoni LF', 'Bodoni FLF', var(--f-display);
    font-weight: 400;
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem);
    line-height: 1.42;
    letter-spacing: 0;
    color: inherit;
    text-wrap: pretty;
  }

  .hero__cta {
    width: min(100%, 20rem);
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .hero__logo {
      width: min(100%, 38rem);
    }

    .hero__cta {
      width: auto;
      min-width: 14rem;
    }
  }

  /* ---------- Concept ---------- */
  .concept__inner {
    margin-bottom: 0;
  }

  .concept__inner .lead {
    max-width: 34rem;
  }

  /* ---------- Process teaser ---------- */
  .steps-inline {
    border-top: 1px solid var(--c-line);
  }

  .steps-inline li {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--c-line);
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--c-plum);
  }

  /* same-width figures, so the step names line up */
  .steps-inline__n {
    min-width: 1.75em;
    font-family: var(--f-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    color: var(--c-bordeaux);
  }

  /* ---------- Story / process / models: text column ---------- */
  @media (min-width: 48rem) {
    .feature__text {
      max-width: 30rem;
    }
  }

  /* ---------- Team strip ---------- */
  .team-strip {
    padding-block: var(--s-7);
  }

  .team-strip__inner {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }

  /* Phones: a wide 16:9 crop (the faces are in the upper part), so the strip stays short.
     From 48rem: the group photo's own shape (900 × 630). */
  .team-strip__media {
    aspect-ratio: 16 / 9;
  }

  .team-strip__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .team-strip__text {
    display: grid;
    justify-items: start;
    gap: var(--s-2);
    max-width: 32rem;
  }

  .team-strip__text .link-arrow {
    margin-top: calc(var(--s-1) * -1);
  }

  @media (min-width: 48rem) {
    .team-strip__inner {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: var(--s-7);
    }

    .team-strip__media {
      aspect-ratio: 900 / 630;
    }
  }

  /* ---------- Instagram ---------- */
  .social__inner {
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    text-align: center;
  }

  .social__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--s-1);
    border-radius: 50%;
    background: var(--c-ivory);
    color: var(--c-bordeaux);
  }

  .social__handle {
    font-size: var(--fs-2xl);
    font-style: italic;
    overflow-wrap: anywhere;
  }

  .social__text {
    max-width: 28rem;
    color: var(--c-anthracite);
  }

  .social .btn {
    width: min(100%, 20rem);
    margin-top: var(--s-3);
  }

  @media (min-width: 48rem) {
    .social .btn {
      width: auto;
    }
  }
</style>
