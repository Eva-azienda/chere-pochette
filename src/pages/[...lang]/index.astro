---
/**
 * Home page – one file for all languages: / (it), /de/, /en/.
 * Sections, in this order: hero (headline, one sentence, one button + the lifestyle photo), the bags
 * on sale (grid with prices), the concept (two sentences), the three models (Belle on the oak chair),
 * how a bag is made (5 steps → /process/), the Ukrainian women (→ /about/), the team strip
 * (group photo → /team/), Instagram.
 * Each section says one thing: the details live on the dedicated pages.
 *
 * Photos: hero-lifestyle.jpg and belle-oak-chair.jpg are generated images, used only here as mood
 * pictures. Product cards always show the real photos of each bag; the women and team sections
 * always show real photos of the project.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtPicture from '../../components/ArtPicture.astro';
import BrandPicture from '../../components/BrandPicture.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import ThreadDivider from '../../components/ThreadDivider.astro';
import heroLifestyle from '../../assets/brand/hero-lifestyle.jpg';
import belleChair from '../../assets/brand/belle-oak-chair.jpg';
import bagUmbrella from '../../assets/brand/hero-bag-umbrella-45.jpg';
import womenLandscape from '../../assets/brand/women-crochet.jpg';
import womenPortrait from '../../assets/brand/women-crochet-45.jpg';
import { localeStaticPaths, useTranslations, type Lang } from '../../lib/i18n';
import { localePath } from '../../lib/urls';
import { getAvailableProducts, models, site } from '../../lib/catalog';
import { teamGroupPhoto } from '../../lib/team-photos';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.props as { lang: Lang };
const { t, list, pageMeta } = useTranslations(lang);

// "Una seconda vita. Una borsa unica." → two lines, the second in italic.
const titleLines = t('home.hero.title').split(/(?<=[.!?])\s+/);
// "Pezzi unici, pronti a partire" → two lines, broken after the comma.
const featuredTitleLines = t('home.featured.title').split(/(?<=,)\s+/);

// Up to 6 bags. From 64rem: 4 columns, or 3 when that fills the rows better (3, 5 or 6 bags).
const featured = (await getAvailableProducts()).slice(0, 6);
const threeColumns = featured.length === 3 || featured.length >= 5;
const cardSizes = threeColumns
  ? '(min-width: 72rem) 22rem, (min-width: 64rem) 30vw, 46vw'
  : '(min-width: 72rem) 16rem, (min-width: 64rem) 22vw, 46vw';

const steps = list<{ title: string }>('process.steps');
// "https://www.instagram.com/chere.pochette/" → "@chere.pochette"
const instagramHandle = `@${site.instagram.match(/instagram\.com\/([^/?#]+)/)?.[1] ?? 'chere.pochette'}`;
---

<BaseLayout lang={lang} path="" {...pageMeta('home')}>
  <!-- ========== Hero ==========
       Phones: headline, one sentence and the shop button first, then the 4:5 photo (whole frame,
       so the bag is always fully visible).
       From 48rem: a compact split, text left and photo right; the photo's height follows the
       screen height, so text and photo fit on the first screen. -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__inner container">
      <div class="hero__text">
        <h1 id="hero-title" class="hero__title">
          {titleLines.map((line) => <span>{line}</span>)}
        </h1>
        <p class="hero__lead">{t('home.hero.lead')}</p>
        <a class="btn btn--primary hero__cta" href={localePath(lang, 'shop/')}>{t('home.hero.cta')}</a>
      </div>
      <div class="hero__media media">
        <BrandPicture
          src={heroLifestyle}
          alt={t('images.heroLifestyle')}
          sizes="(min-width: 64rem) 28rem, (min-width: 48rem) 40vw, calc(100vw - 2rem)"
          widths={[400, 560, 720, 900, 1120]}
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- ========== Bags on sale ==========
       A grid (never a carousel): 2 columns on phones, 3–4 from 64rem. The real photo, name, price
       and link of every bag. -->
  <section class="section featured" aria-labelledby="featured-title">
    <div class="container">
      <div class="heading featured__heading">
        <p class="eyebrow">{t('home.featured.eyebrow')}</p>
        <h2 id="featured-title" class="featured__title">
          {featuredTitleLines.map((line) => <span>{line}</span>)}
        </h2>
        <p>{t('home.featured.text')}</p>
      </div>

      {
        featured.length > 0 ? (
          <>
            <ul role="list" class:list={['product-grid', { 'featured__grid--3': threeColumns }]}>
              {featured.map((product) => (
                <li>
                  <ProductCard product={product} lang={lang} sizes={cardSizes} />
                </li>
              ))}
            </ul>
            <div class="featured__more">
              <a class="btn btn--outline" href={localePath(lang, 'shop/')}>{t('home.featured.cta')}</a>
            </div>
          </>
        ) : (
          <div class="empty">
            <ThreadDivider />
            <p class="lead">{t('home.featured.empty')}</p>
            <a class="btn btn--outline" href={site.instagram} rel="noopener">
              <Icon name="instagram" size={20} />
              {t('common.followInstagram')}
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- ========== The concept ==========
       Two sentences, no picture: outside a garment, inside an umbrella. -->
  <section class="section section--alt concept" aria-labelledby="concept-title">
    <div class="container container--narrow heading center concept__inner">
      <p class="eyebrow">{t('home.concept.eyebrow')}</p>
      <h2 id="concept-title">{t('home.concept.title')}</h2>
      <p class="lead">{t('home.concept.text')}</p>
    </div>
  </section>

  <!-- ========== The three models ==========
       The Belle on the oak chair introduces the models; each name links to the shop filtered by
       that model (shop/#belle). Phones: photo above the text. From 48rem: photo left. -->
  <section class="section models" aria-labelledby="models-title">
    <div class="container feature">
      <figure class="feature__media media models__media">
        <BrandPicture
          src={belleChair}
          alt={t('images.belleOakChair')}
          sizes="(min-width: 72rem) 34rem, (min-width: 48rem) 45vw, calc(100vw - 2rem)"
          widths={[480, 720, 960, 1120]}
          position="50% 52%"
        />
        <figcaption class="models__caption">Belle</figcaption>
      </figure>
      <div class="feature__text stack">
        <p class="eyebrow">{t('home.models.eyebrow')}</p>
        <h2 id="models-title">{t('home.models.title')}</h2>
        <p>{t('home.models.text')}</p>
        <ul role="list" class="models__list">
          {
            models.map((model) => (
              <li>
                <a href={localePath(lang, `shop/#${model.id}`)}>
                  <span class="models__name">{model.name}</span>
                  <span class="models__type">{model.type[lang]}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="link-arrow" href={localePath(lang, 'shop/')}>{t('home.models.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ========== How a bag is made ==========
       A real photo of a crocheted bag on umbrella fabric, the five steps, link to /process/
       (the recovered-material photos are on that page). From 48rem: photo right. -->
  <section class="section section--alt process-teaser" aria-labelledby="process-title">
    <div class="container feature feature--reverse">
      <div class="feature__media media">
        <BrandPicture
          src={bagUmbrella}
          alt={t('images.heroBagUmbrella')}
          sizes="(min-width: 72rem) 34rem, (min-width: 48rem) 45vw, calc(100vw - 2rem)"
          widths={[480, 768, 1080, 1440]}
          position="50% 60%"
        />
      </div>
      <div class="feature__text stack">
        <p class="eyebrow">{t('home.process.eyebrow')}</p>
        <h2 id="process-title">{t('home.process.title')}</h2>
        <p>{t('home.process.text')}</p>
        <ol role="list" class="steps-inline">
          {
            steps.map((step, i) => (
              <li>
                <span class="steps-inline__n">{String(i + 1).padStart(2, '0')}</span>
                {step.title}
              </li>
            ))
          }
        </ol>
        <a class="link-arrow" href={localePath(lang, 'process/')}>{t('home.process.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ========== Together with the Ukrainian women ==========
       Real photo: women-crochet.jpg (landscape) above the text on phones, its 4:5 crop
       women-crochet-45.jpg on the left from 48rem. -->
  <section class="section story" aria-labelledby="story-title">
    <div class="container feature">
      <div class="feature__media media">
        <ArtPicture
          mobile={womenLandscape}
          desktop={womenPortrait}
          alt={t('images.womenCrochet')}
          mobileSizes="calc(100vw - 2rem)"
          desktopSizes="(min-width: 72rem) 34rem, 45vw"
          mobilePosition="50% 45%"
          desktopPosition="50% 40%"
        />
      </div>
      <div class="feature__text stack">
        <p class="eyebrow">{t('home.story.eyebrow')}</p>
        <h2 id="story-title">{t('home.story.title')}</h2>
        <p>{t('home.story.text')}</p>
        <a class="link-arrow" href={localePath(lang, 'about/')}>{t('home.story.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ========== The team (compact strip) ==========
       Real group photo (src/assets/team/group.jpg). Phones: photo, then text. From 48rem: photo left. -->
  <section class="section section--alt team-strip" aria-labelledby="team-title">
    <div class="container team-strip__inner">
      {
        teamGroupPhoto && (
          <div class="media team-strip__media">
            <BrandPicture
              src={teamGroupPhoto}
              alt={t('images.teamGroup')}
              sizes="(min-width: 48rem) 26rem, calc(100vw - 2rem)"
              widths={[480, 768, 900]}
            />
          </div>
        )
      }
      <div class="team-strip__text">
        <p class="eyebrow">{t('home.team.eyebrow')}</p>
        <h2 id="team-title" class="h3">{t('home.team.title')}</h2>
        <p>{t('home.team.text')}</p>
        <a class="link-arrow" href={localePath(lang, 'team/')}>{t('home.team.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ========== Instagram ==========
       A plain link to the profile: no embedded feed and no third-party script (privacy). -->
  <section class="section section--powder social" aria-labelledby="social-title">
    <div class="container container--narrow social__inner">
      <span class="social__icon"><Icon name="instagram" size={28} /></span>
      <p class="eyebrow">{t('home.social.eyebrow')}</p>
      <h2 id="social-title" class="social__handle">{instagramHandle}</h2>
      <p class="social__text">{t('home.social.text')}</p>
      <a class="btn btn--primary" href={site.instagram} rel="noopener">
        <Icon name="instagram" size={20} />
        {t('common.followInstagram')}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ----------
     Phones: text centred, then the photo at full width in 4:5 (the photo's own shape, nothing
     is cut off). From 48rem: two columns, text left; the photo is as tall as the screen allows
     (minus header and padding), never taller than 35rem. */
  .hero {
    padding-block: var(--s-4) var(--s-6);
  }

  .hero__inner {
    display: grid;
    gap: var(--s-5);
  }

  .hero__text {
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    text-align: center;
  }

  .hero__title {
    font-size: clamp(1.875rem, 1.2rem + 3vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero__title span {
    display: block;
  }

  .hero__title span + span {
    font-style: italic;
    color: var(--c-bordeaux);
  }

  .hero__lead {
    max-width: 26em;
    font-size: var(--fs-base);
    line-height: 1.5;
    color: var(--c-anthracite);
  }

  .hero__cta {
    width: min(100%, 20rem);
    margin-top: var(--s-2);
    white-space: nowrap;
  }

  .hero__media {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
  }

  .hero__media :global(picture),
  .hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--s-6) var(--s-7);
    }

    .hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--s-7);
    }

    .hero__text {
      justify-items: start;
      gap: var(--s-4);
      text-align: left;
    }

    .hero__lead {
      font-size: var(--fs-lg);
    }

    .hero__cta {
      width: auto;
    }

    /* at most 40% of the width, so "Una seconda vita." stays on one line on tablets */
    .hero__media {
      width: clamp(17rem, (100svh - 13rem) * 0.8, 28rem);
      max-width: 40vw;
    }
  }

  @media (min-width: 64rem) {
    .hero__inner {
      column-gap: var(--s-8);
    }

    .hero__text {
      gap: var(--s-5);
    }
  }

  /* ---------- Bags on sale ---------- */
  .featured {
    padding-top: var(--s-6);
  }

  .featured__heading {
    margin-bottom: var(--s-5);
  }

  .featured__title span {
    display: block;
  }

  /* phones: a little less space between the rows of cards */
  .featured .product-grid {
    row-gap: var(--s-5);
  }

  @media (min-width: 64rem) {
    .featured {
      padding-top: var(--s-7);
    }

    .featured .product-grid {
      row-gap: var(--s-7);
    }

    .featured .featured__grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .featured__more {
    display: flex;
    justify-content: center;
    margin-top: var(--s-6);
  }

  .featured__more .btn {
    width: min(100%, 20rem);
  }

  /* ---------- Concept ---------- */
  .concept__inner {
    margin-bottom: 0;
  }

  .concept__inner .lead {
    max-width: 34rem;
  }

  /* ---------- Models ---------- */
  .models__media {
    position: relative;
    margin: 0;
  }

  /* the model's name on the photo, like a small label */
  .models__caption {
    position: absolute;
    left: var(--s-3);
    bottom: var(--s-3);
    padding: var(--s-1) var(--s-3);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c-ivory) 92%, transparent);
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--fs-base);
    color: var(--c-plum);
  }

  /* one row per model: name (Bodoni) + type, the whole row is a 48px link */
  .models__list {
    border-top: 1px solid var(--c-line);
  }

  .models__list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: var(--tap);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--c-line);
    color: inherit;
    text-decoration: none;
  }

  .models__name {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--c-plum);
  }

  .models__type {
    font-size: var(--fs-sm);
    color: var(--c-muted);
    text-align: right;
  }

  .models__list a:hover .models__name {
    color: var(--c-bordeaux);
  }

  /* ---------- Process teaser ---------- */
  .steps-inline {
    border-top: 1px solid var(--c-line);
  }

  .steps-inline li {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--c-line);
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--c-plum);
  }

  /* same-width figures, so the step names line up */
  .steps-inline__n {
    min-width: 1.75em;
    font-family: var(--f-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    color: var(--c-bordeaux);
  }

  /* ---------- Story / process / models: text column ---------- */
  @media (min-width: 48rem) {
    .feature__text {
      max-width: 30rem;
    }
  }

  /* ---------- Team strip ---------- */
  .team-strip {
    padding-block: var(--s-7);
  }

  .team-strip__inner {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }

  /* Phones: a wide 16:9 crop (the faces are in the upper part), so the strip stays short.
     From 48rem: the group photo's own shape (900 × 630). */
  .team-strip__media {
    aspect-ratio: 16 / 9;
  }

  .team-strip__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .team-strip__text {
    display: grid;
    justify-items: start;
    gap: var(--s-2);
    max-width: 32rem;
  }

  .team-strip__text .link-arrow {
    margin-top: calc(var(--s-1) * -1);
  }

  @media (min-width: 48rem) {
    .team-strip__inner {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: var(--s-7);
    }

    .team-strip__media {
      aspect-ratio: 900 / 630;
    }
  }

  /* ---------- Instagram ---------- */
  .social__inner {
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    text-align: center;
  }

  .social__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--s-1);
    border-radius: 50%;
    background: var(--c-ivory);
    color: var(--c-bordeaux);
  }

  .social__handle {
    font-size: var(--fs-2xl);
    font-style: italic;
    overflow-wrap: anywhere;
  }

  .social__text {
    max-width: 28rem;
    color: var(--c-anthracite);
  }

  .social .btn {
    width: min(100%, 20rem);
    margin-top: var(--s-3);
  }

  @media (min-width: 48rem) {
    .social .btn {
      width: auto;
    }
  }
</style>
