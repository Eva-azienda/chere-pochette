---
/**
 * The team: group photo (src/assets/team/group.jpg) and the interactive org chart
 * (data: src/data/team.json, portraits: src/assets/team/<slug>.jpg).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BrandPicture from '../../../components/BrandPicture.astro';
import OrgChart from '../../../components/OrgChart.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { localeStaticPaths, useTranslations, type Lang } from '../../../lib/i18n';
import { localePath, assetPath } from '../../../lib/urls';
import { teamGroupPhoto } from '../../../lib/team-photos';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.props as { lang: Lang };
const { t, pageMeta } = useTranslations(lang);
---

<BaseLayout lang={lang} path="team/" {...pageMeta('team')}>
  <PageHeader eyebrow={t('team.eyebrow')} title={t('team.title')} intro={t('team.intro')} thread={false}>
    <!-- Original logo motif, not the hand-drawn ThreadDivider component. -->
    <img
      class="team__official-needle"
      src={assetPath('brand/needle-from-official-logo.svg')}
      alt=""
      width="532"
      height="174"
      aria-hidden="true"
      loading="eager"
    />
  </PageHeader>

  {
    teamGroupPhoto && (
      <div class="container group">
        <div class="group__frame media">
          <BrandPicture
            src={teamGroupPhoto}
            alt={t('images.teamGroup')}
            sizes="(min-width: 60rem) 900px, 100vw"
            widths={[480, 768, 900]}
            loading="eager"
          />
        </div>
      </div>
    )
  }

  <section class="container org-wrap">
    <!-- The hint sits right above the chart, so it isn't read as being about the group photo. -->
    <p class="hint center">
      <span class="hint--touch">{t('team.hint')}</span>
      <span class="hint--pointer">{t('team.hintPointer')}</span>
    </p>
    <OrgChart lang={lang} />
  </section>

  <section class="section section--alt">
    <div class="container container--narrow center stack">
      <p class="tagline">{t('about.title')}</p>
      <div class="btn-row">
        <a class="btn btn--outline" href={localePath(lang, 'about/')}>{t('home.story.cta')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(.team__official-needle) {
    display: block;
    width: min(100%, 17rem);
    height: auto;
    margin-inline: auto;
    margin-top: var(--s-2);
  }

  .hint {
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .hint--pointer {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .hint--touch {
      display: none;
    }

    .hint--pointer {
      display: inline;
    }
  }

  .group {
    max-width: calc(56.25rem + 2 * var(--gutter)); /* 900px: the size of the photo */
    margin-bottom: var(--s-7);
  }

  /* Show the original 900x630 group photograph COMPLETELY.
     The shared .media class normally forces object-fit: cover inside a
     fixed-ratio frame; this gallery photo must never be cropped. */
  .group__frame {
    aspect-ratio: auto;
    height: auto;
    overflow: visible;
    background: transparent;
  }

  .group__frame :global(picture),
  .group__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    aspect-ratio: auto;
    object-fit: contain;
  }

  .group__frame :global(img) {
    border-radius: var(--radius-sm);
  }

  .hint {
    margin-bottom: var(--s-6);
  }

  .org-wrap {
    padding-bottom: var(--section-y);
  }
</style>
