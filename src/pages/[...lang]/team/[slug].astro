---
/**
 * Personal page of a team member: /team/<slug>/.
 * Skills and experience are shown only when filled in (src/data/team.json).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import Monogram from '../../../components/Monogram.astro';
import ThreadDivider from '../../../components/ThreadDivider.astro';
import { LOCALES, langParam, useTranslations, type Lang } from '../../../lib/i18n';
import { localePath } from '../../../lib/urls';
import { roleDescription, team, type TeamMember } from '../../../lib/catalog';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    team.map((member) => ({
      params: { lang: langParam(lang), slug: member.slug },
      props: { lang, member },
    })),
  );
}

const { lang, member } = Astro.props as { lang: Lang; member: TeamMember };
const { t } = useTranslations(lang);

const role = member.roleTitle[lang];
const meta = {
  title: t('meta.titleTemplate', { title: t('meta.pages.teamMember.title', { name: member.name, role: member.roleCode }) }),
  description: t('meta.pages.teamMember.description', { name: member.name, role }),
};

const sections = [
  { key: 'responsibilities', items: member.responsibilities[lang] },
  { key: 'education', items: member.education[lang] },
  { key: 'skills', items: member.skills[lang] },
  { key: 'experience', items: member.experience[lang] },
].filter((s) => s.items.length > 0);

// Previous / next profile (in org-chart order, looping around).
const index = team.findIndex((m) => m.slug === member.slug);
const prev = team[(index - 1 + team.length) % team.length];
const next = team[(index + 1) % team.length];
---

<BaseLayout lang={lang} path={`team/${member.slug}/`} {...meta}>
  <nav class="container back" aria-label={t('a11y.breadcrumb')}>
    <a href={localePath(lang, 'team/')} class="back__link">
      <Icon name="arrow-left" size={18} />
      {t('team.member.backToTeam')}
    </a>
  </nav>

  <article class="container container--narrow profile">
    <header class="profile__head">
      <Monogram name={member.name} size="lg" />
      <p class="eyebrow">{member.roleCode}</p>
      <h1>{member.name}</h1>
      <p class="profile__role">{roleDescription(member, lang)}</p>
      <ThreadDivider />
    </header>

    <section class="profile__section" aria-labelledby="about-title">
      <h2 id="about-title">{t('team.member.about')}</h2>
      <p class="lead">{member.bio[lang]}</p>
    </section>

    {
      sections.map((section) => (
        <section class="profile__section" aria-labelledby={`${section.key}-title`}>
          <h2 id={`${section.key}-title`}>{t(`team.member.${section.key}`)}</h2>
          <ul class="profile__list">
            {section.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))
    }

    <nav class="pager" aria-label={t('a11y.orgChart')}>
      <a href={localePath(lang, `team/${prev.slug}/`)} rel="prev" class="pager__link">
        <span class="pager__label"><Icon name="arrow-left" size={16} /> {t('team.member.previous')}</span>
        <span class="pager__name">{prev.name}</span>
      </a>
      <a href={localePath(lang, `team/${next.slug}/`)} rel="next" class="pager__link pager__link--next">
        <span class="pager__label">{t('team.member.next')} <Icon name="arrow-right" size={16} /></span>
        <span class="pager__name">{next.name}</span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .back {
    padding-block: var(--s-2);
  }

  .back__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--c-plum);
    text-decoration: none;
  }

  .profile {
    display: grid;
    gap: var(--s-7);
    padding-bottom: var(--section-y);
  }

  .profile__head {
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    padding-top: var(--s-4);
    text-align: center;
  }

  .profile__head :global(.monogram) {
    margin-bottom: var(--s-3);
  }

  .profile__role {
    max-width: 28rem;
    color: var(--c-muted);
  }

  .profile__head :global(.thread) {
    width: 100%;
    margin-top: var(--s-4);
  }

  .profile__section {
    display: grid;
    gap: var(--s-3);
  }

  .profile__section h2 {
    font-size: var(--fs-xs);
    font-family: var(--f-body);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--c-bordeaux);
  }

  .profile__list {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }

  .profile__list li {
    position: relative;
    padding-left: var(--s-5);
  }

  .profile__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.75rem;
    height: 1px;
    background: var(--c-bordeaux);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-line);
  }

  .pager__link {
    display: grid;
    gap: var(--s-1);
    min-height: var(--tap);
    padding-block: var(--s-2);
    color: inherit;
    text-decoration: none;
  }

  .pager__link--next {
    justify-items: end;
    text-align: right;
  }

  .pager__label {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .pager__name {
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--c-plum);
  }

  .pager__link:hover .pager__name {
    color: var(--c-bordeaux);
  }
</style>
