---
/**
 * Original curriculum text transcribed from the seven-page CV.pdf provided by
 * the team. Every visitor sees exactly one person's CV and can return to the
 * organigram. Existing photographs in src/assets/team/ remain untouched.
 * All original CV text is retained in Italian, as provided.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import Monogram from '../../../components/Monogram.astro';
import { LOCALES, langParam, useTranslations, type Lang } from '../../../lib/i18n';
import { localePath } from '../../../lib/urls';
import { team, type TeamMember } from '../../../lib/catalog';
import { teamPhoto } from '../../../lib/team-photos';
import { breadcrumbJsonLd } from '../../../lib/structured-data';
import { metaDescription } from '../../../lib/format';
import originalCvs from '../../../data/cv-original.json';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    team.map((member) => ({
      params: { lang: langParam(lang), slug: member.slug },
      props: { lang, member },
    })),
  );
}

const { lang, member } = Astro.props as { lang: Lang; member: TeamMember };
const { t } = useTranslations(lang);
const cv = originalCvs[member.slug as keyof typeof originalCvs];
if (!cv) throw new Error('Missing original CV for ' + member.slug);
const photo = teamPhoto(member);
const photoWidths = [240, 296, 480].filter((w) => photo && w <= photo.width);
const meta = {
  title: t('meta.titleTemplate', { title: t('meta.pages.teamMember.title', { name: member.name, role: member.roleCode }) }),
  description: metaDescription(member.bio[lang]),
};
const profileDraft = LOCALES.some((l) => member.skills[l].length === 0 || member.experience[l].length === 0);
const jsonLd = breadcrumbJsonLd(lang, [
  { name: t('nav.home'), path: '' },
  { name: t('nav.team'), path: 'team/' },
  { name: member.name, path: 'team/' + member.slug + '/' },
]);
const backHref = localePath(lang, 'team/');
---

<BaseLayout lang={lang} path={'team/' + member.slug + '/'} {...meta} noindex={profileDraft} jsonLd={jsonLd}>
  <article class="container cv">
    <div class="cv__paper">
      <header class="cv__hero">
        <div class="cv__intro">
          <p class="cv__code">{cv.code}</p>
          <h1>{member.name}</h1>
          <p class="cv__position">{cv.title}</p>
          <p class="cv__description">{cv.introduction}</p>
        </div>
        <div class="cv__portrait">
          {
            photo ? (
              <Picture
                src={photo}
                alt={t('team.member.photoAlt', { name: member.name })}
                formats={['avif', 'webp']}
                widths={photoWidths}
                sizes="(min-width: 48rem) 296px, 240px"
                class="portrait"
                loading="eager"
              />
            ) : (
              <Monogram name={member.name} size="lg" />
            )
          }
        </div>
      </header>

      <div class="cv__content">
        <div class="cv__column">
          <section class="cv__section" aria-labelledby="cv-education">
            <h2 id="cv-education">FORMAZIONE</h2>
            <ul>
              {cv.education.map((school) => (
                <li>
                  <strong>{school.school}</strong>
                  <span class="cv__course">{school.course}</span>
                  <span class="cv__period">{school.period}</span>
                </li>
              ))}
            </ul>
          </section>

          <section class="cv__section" aria-labelledby="cv-languages">
            <h2 id="cv-languages">LINGUE</h2>
            <ul>{cv.languages.map((item) => <li>{item}</li>)}</ul>
          </section>
        </div>

        <div class="cv__column">
          <section class="cv__section" aria-labelledby="cv-skills">
            <h2 id="cv-skills">COMPETENZE PROFESSIONALI</h2>
            <ul>{cv.skills.map((item) => <li>{item}</li>)}</ul>
          </section>

          <section class="cv__section" aria-labelledby="cv-interests">
            <h2 id="cv-interests">INTERESSI PROFESSIONALI</h2>
            <ul>{cv.interests.map((item) => <li>{item}</li>)}</ul>
          </section>
        </div>
      </div>
    </div>
    <div class="cv__footer">
      <a class="btn btn--outline" href={backHref}>
        <Icon name="arrow-left" size={18} />
        {t('team.member.backToTeam')}
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .cv {
    max-width: calc(64rem + 2 * var(--gutter));
    padding-bottom: var(--section-y);
  }
  .cv__paper {
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-white);
  }
  .cv__hero {
    display: grid;
    align-items: center;
    gap: var(--s-5);
    padding: var(--s-6);
    background: var(--c-powder);
  }
  .cv__intro {
    min-width: 0;
  }
  .cv__code {
    font-family: var(--f-display);
    font-size: clamp(2.1rem, 5vw, 3.7rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--c-bordeaux);
  }
  .cv__intro h1 {
    font-family: var(--f-display);
    font-size: clamp(1.45rem, 3vw, 2.5rem);
    color: var(--c-plum);
    margin-top: var(--s-2);
    line-height: 1.2;
  }
  .cv__position {
    margin-top: var(--s-1);
    font-weight: 600;
    color: var(--c-bordeaux);
  }
  .cv__description {
    margin-top: var(--s-4);
    line-height: 1.75;
    color: var(--c-plum);
  }
  .cv__portrait {
    justify-self: center;
    display: grid;
    align-items: end;
    width: min(100%, 15rem);
    min-height: 0;
  }
  .cv__portrait :global(.portrait) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius);
  }
  .cv__content {
    display: grid;
    gap: var(--s-7);
    padding: var(--s-6);
  }
  .cv__column {
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
    min-width: 0;
  }
  .cv__section h2 {
    font-family: var(--f-display);
    font-size: clamp(1.05rem, 2.2vw, 1.45rem);
    letter-spacing: 0.06em;
    line-height: 1.3;
    color: var(--c-bordeaux);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--c-line-strong);
    margin-bottom: var(--s-4);
  }
  .cv__section ul {
    padding-left: 1.35rem;
    display: grid;
    gap: var(--s-3);
    list-style: disc;
  }
  .cv__section li {
    padding-left: var(--s-1);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .cv__section li::marker {
    color: var(--c-bordeaux);
  }
  .cv__section li strong {
    display: block;
    font-weight: 600;
  }
  .cv__course,
  .cv__period {
    display: block;
  }
  .cv__course {
    font-style: italic;
  }
  .cv__period {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .cv__footer {
    text-align: center;
    padding-top: var(--s-6);
  }
  .cv__footer :global(.btn) {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
  }
  @media (min-width: 48rem) {
    .cv__hero {
      grid-template-columns: minmax(0, 1fr) minmax(11rem, 18rem);
      padding: var(--s-7);
    }
    .cv__portrait {
      justify-self: end;
      width: 100%;
    }
    .cv__content {
      grid-template-columns: 0.9fr 1.1fr;
      padding: var(--s-7);
      gap: var(--s-8);
    }
  }
</style>
