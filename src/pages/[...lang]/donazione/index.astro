---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { localeStaticPaths, useTranslations, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.props as { lang: Lang };
const { t, pageMeta } = useTranslations(lang);
const amount = 'CHF 5.–';
---

<BaseLayout lang={lang} path="donazione/" {...pageMeta('donation', { amount })}>
  <PageHeader title={t('donation.title')} intro={t('donation.intro', { amount })} />

  <div class="section section--powder">
    <div class="container container--narrow stack">
      <p>{t('donation.commitment')}</p>
      <p>{t('donation.association')}</p>
      <a class="link-arrow" href="https://consultoriodelledonne.ch/chi-siamo/">
        {t('donation.visit')}
      </a>
    </div>
  </div>
</BaseLayout>
