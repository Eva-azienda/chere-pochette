---
/** From umbrella to bag: the 5 steps, joined by a thin thread. */
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BrandPicture from '../../../components/BrandPicture.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ThreadDivider from '../../../components/ThreadDivider.astro';
import umbrellasCollected from '../../../assets/brand/umbrellas-collected.jpg';
import umbrellasFabrics from '../../../assets/brand/umbrellas-fabrics.jpg';
import womenCrochet from '../../../assets/brand/women-crochet-45.jpg';
import bagUmbrella from '../../../assets/brand/hero-bag-umbrella-45.jpg';
import bagHands from '../../../assets/brand/hero-bag-hands-45.jpg';
import { localeStaticPaths, useTranslations, type Lang } from '../../../lib/i18n';
import { localePath } from '../../../lib/urls';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.props as { lang: Lang };
const { t, list, pageMeta } = useTranslations(lang);
const steps = list<{ id: string; title: string; text: string }>('process.steps');

// Photo for each step id (ids are fixed in the language files: see src/i18n/README.md).
// "creation" uses the crochet photo: the yarn photo shows new spools, not recovered material.
const photos: Record<string, { src: ImageMetadata; alt: string; position?: string }> = {
  recovery: { src: umbrellasCollected, alt: 'images.umbrellasCollected', position: '40% 50%' },
  selection: { src: umbrellasFabrics, alt: 'images.umbrellasFabrics' },
  creation: { src: womenCrochet, alt: 'images.womenCrochet', position: '50% 40%' },
  lining: { src: bagUmbrella, alt: 'images.heroBagUmbrella', position: '53% 60%' },
  final: { src: bagHands, alt: 'images.heroBagHands' },
};
// The first step photo is visible right below the title: load it first (largest image on screen).
const firstPhoto = steps.findIndex((step) => photos[step.id]);
---

<BaseLayout lang={lang} path="process/" {...pageMeta('process')}>
  <PageHeader eyebrow={t('process.eyebrow')} title={t('process.title')} intro={t('process.intro')} />

  <section class="container steps-wrap">
    <ol role="list" class="steps">
      {
        steps.map((step, i) => {
          const photo = photos[step.id];
          return (
            <li class="step">
              <div class="step__rail" aria-hidden="true">
                <span class="step__dot">{i + 1}</span>
              </div>
              <div class="step__body">
                {photo && (
                  <div class="step__media media">
                    <BrandPicture
                      src={photo.src}
                      alt={t(photo.alt)}
                      sizes="(min-width: 64rem) 30rem, (min-width: 48rem) 45vw, 85vw"
                      widths={[400, 640, 960, 1280]}
                      position={photo.position}
                      loading={i === firstPhoto ? 'eager' : 'lazy'}
                    />
                  </div>
                )}
                <div class="step__text">
                  <p class="eyebrow">{t('process.stepLabel', { n: i + 1 })}</p>
                  <h2>{step.title}</h2>
                  <p>{step.text}</p>
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="section section--powder">
    <div class="container container--narrow center stack">
      <ThreadDivider />
      <h2>{t('process.closing.title')}</h2>
      <p class="lead">{t('process.closing.text')}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={localePath(lang, 'shop/')}>{t('process.closing.cta')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .steps-wrap {
    padding-bottom: var(--section-y);
  }

  .steps {
    --rail: 2.5rem;
    display: grid;
    max-width: 62rem;
    margin-inline: auto;
  }

  .step {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--s-4);
  }

  /* the thread: a thin vertical line behind the numbers, from one step to the next */
  .step__rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .step__rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--c-line-strong);
  }

  .step:first-child .step__rail::before {
    top: 1.25rem;
  }

  .step:last-child .step__rail::before {
    bottom: auto;
    height: 1.25rem;
  }

  .step__dot {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--rail);
    height: var(--rail);
    border: 1px solid var(--c-bordeaux);
    border-radius: 50%;
    background: var(--c-ivory);
    font-family: var(--f-display);
    font-size: var(--fs-lg);
    color: var(--c-bordeaux);
  }

  .step:last-child .step__dot {
    background: var(--c-bordeaux);
    color: var(--c-ivory);
  }

  .step__body {
    display: grid;
    gap: var(--s-5);
    padding-bottom: var(--s-8);
  }

  .step:last-child .step__body {
    padding-bottom: 0;
  }

  .step__media {
    aspect-ratio: 4 / 5;
  }

  .step__media :global(picture),
  .step__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .step__text {
    display: grid;
    gap: var(--s-3);
  }

  .step__text h2 {
    font-size: var(--fs-2xl);
  }

  @media (min-width: 48rem) {
    .steps {
      --rail: 3rem;
    }

    .step__body {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--s-7);
    }

    .step:nth-child(even) .step__media {
      order: 2;
    }
  }
</style>
