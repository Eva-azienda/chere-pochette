---
/**
 * Interactive team chart. The CEO sits above the CAO; the five other areas are
 * displayed beneath. Each card opens only that person's curriculum page.
 * The original portrait files in src/assets/team/ are never edited here.
 */
import TeamAvatar from './TeamAvatar.astro';
import { type Lang, useTranslations } from '../lib/i18n';
import { localePath } from '../lib/urls';
import { roleDescription, team } from '../lib/catalog';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const { t } = useTranslations(lang);
const ceo = team.find((m) => m.roleCode === 'CEO');
const cao = team.find((m) => m.roleCode === 'CAO');
const remaining = team.filter((m) => m.roleCode !== 'CEO' && m.roleCode !== 'CAO');
if (!ceo || !cao || remaining.length !== 5) throw new Error('Team organigram: expected one CEO, one CAO and five other members');
---

<div class="org" role="group" aria-label={t('a11y.orgChart')}>
  <p class="org__level">{t('team.levels.level1')}</p>
  <a class="member member--chief" href={localePath(lang, 'team/' + ceo.slug + '/')}>
    <TeamAvatar member={ceo} lead />
    <span class="member__code">{ceo.roleCode}</span>
    <span class="member__name">{ceo.name}</span>
    <span class="member__role">{roleDescription(ceo, lang)}</span>
    <span class="member__more" aria-hidden="true">→</span>
  </a>

  <div class="org__thread" aria-hidden="true"></div>
  <a class="member member--admin" href={localePath(lang, 'team/' + cao.slug + '/')}>
    <TeamAvatar member={cao} />
    <span class="member__code">{cao.roleCode}</span>
    <span class="member__name">{cao.name}</span>
    <span class="member__role">{roleDescription(cao, lang)}</span>
    <span class="member__more" aria-hidden="true">→</span>
  </a>

  <div class="org__thread" aria-hidden="true"></div>
  <p class="org__level org__level--others">{t('team.levels.level2')}</p>
  <div class="org__thread org__thread--short" aria-hidden="true"></div>
  <ul role="list" class="org__remaining">
    {
      remaining.map((member) => (
        <li>
          <a class="member" href={localePath(lang, 'team/' + member.slug + '/')}>
            <TeamAvatar member={member} />
            <span class="member__code">{member.roleCode}</span>
            <span class="member__name">{member.name}</span>
            <span class="member__role">{roleDescription(member, lang)}</span>
            <span class="member__more" aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .org {
    --thread: var(--c-line-strong);
    --gap: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .org__level {
    font-family: var(--f-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-align: center;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-bottom: var(--s-4);
  }

  .org__level--others {
    margin: 0;
    padding: var(--s-2) 0;
  }

  .org__thread {
    height: clamp(1.5rem, 3.5vw, 2.5rem);
    width: 1px;
    background: var(--thread);
  }

  .org__thread--short {
    height: 1.5rem;
  }

  .member {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: center;
    gap: var(--s-1);
    width: 100%;
    height: 100%;
    min-width: 0;
    padding: var(--s-5) var(--s-3) var(--s-6);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-white);
    color: inherit;
    text-align: center;
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .member--chief {
    max-width: 18rem;
    background: var(--c-powder-2);
  }

  .member--admin {
    max-width: 16rem;
  }

  .member :global(.avatar),
  .member :global(.monogram) {
    margin-bottom: var(--s-3);
  }

  .member:hover,
  .member:focus-visible {
    border-color: var(--c-bordeaux);
    box-shadow: var(--shadow-soft);
    transform: translateY(-2px);
    color: inherit;
  }

  .member:focus-visible {
    outline: 2px solid var(--c-bordeaux);
    outline-offset: 3px;
  }

  .member__code {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    color: var(--c-bordeaux);
  }

  .member__name {
    font-family: var(--f-display);
    font-size: 1.125rem;
    line-height: 1.2;
    text-wrap: balance;
    color: var(--c-plum);
  }

  .member--chief .member__name {
    font-size: var(--fs-xl);
  }

  .member__role {
    font-size: var(--fs-xs);
    line-height: 1.4;
    color: var(--c-muted);
    text-wrap: balance;
  }

  .member__more {
    position: absolute;
    right: var(--s-3);
    bottom: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--c-bordeaux);
  }

  .org__remaining {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    width: 100%;
    max-width: 39rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .org__remaining li {
    min-width: 0;
    list-style: none;
  }

  .org__remaining li:last-child {
    grid-column: 1 / -1;
    width: calc((100% - var(--gap)) / 2);
    justify-self: center;
  }

  @media (min-width: 64rem) {
    .org__remaining {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--s-4);
      max-width: none;
    }

    .org__remaining li:last-child {
      grid-column: auto;
      width: auto;
    }

    .member {
      padding-inline: var(--s-2);
    }
  }
</style>
