---
/**
 * An editorial photo from src/assets/brand/, optimised by Astro (AVIF + WebP + JPEG fallback,
 * several widths). Always give a meaningful `alt` (from the "images" texts) and a `sizes`
 * that says how wide the image is on screen, so phones download a small file.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  /** CSS object-position (focal point), e.g. "50% 40%". */
  position?: string;
  class?: string;
  /** "eager" only for a photo that is visible when the page opens (it then also loads first). */
  loading?: 'lazy' | 'eager';
}

const { src, alt, sizes, widths, position, class: className, loading = 'lazy' } = Astro.props;
// Never ask for a width larger than the original file (Astro doesn't upscale).
const candidateWidths = (widths ?? [480, 768, 1080, 1440, 1920]).filter((w) => w <= src.width);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={candidateWidths}
  sizes={sizes}
  class={className}
  style={position ? `object-position: ${position}` : undefined}
  loading={loading}
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  decoding="async"
/>
