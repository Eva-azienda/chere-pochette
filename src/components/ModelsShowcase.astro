---
import ProductGallery from './ProductGallery.astro';
import essentielleFront from '../assets/brand/collection/essentielle-front.jpg';
import essentielleInside from '../assets/brand/collection/essentielle-inside.jpg';
import jolieFront from '../assets/brand/collection/jolie-front.jpg';
import jolieInside from '../assets/brand/collection/jolie-inside.jpg';
import belleFront from '../assets/brand/collection/belle-front.jpg';
import belleInside from '../assets/brand/collection/belle-inside.jpg';
import coquetteFront from '../assets/brand/collection/coquette-front.jpg';
import coquetteInside from '../assets/brand/collection/coquette-inside.jpg';
import { type Lang, useTranslations } from '../lib/i18n';
import { formatPrice } from '../lib/format';

interface Props {
  lang: Lang;
  headingLevel?: 1 | 2;
}

const { lang, headingLevel = 2 } = Astro.props;
const { t } = useTranslations(lang);
const Heading = headingLevel === 1 ? 'h1' : 'h2';
const ModelHeading = headingLevel === 1 ? 'h2' : 'h3';
const collection = [
  { id: 'essentielle', name: 'Essentielle', photos: [essentielleFront, essentielleInside], strap: false },
  { id: 'jolie', name: 'Jolie', photos: [jolieFront, jolieInside], strap: true },
  { id: 'belle', name: 'Belle', photos: [belleFront, belleInside], strap: true },
  { id: 'coquette', name: 'Coquette', photos: [coquetteFront, coquetteInside], strap: true },
];
---

<section class="section collection" id="collection" aria-labelledby="collection-title">
  <div class="container">
    <div class="heading">
      <p class="eyebrow">{t('shop.models.eyebrow')}</p>
      <Heading id="collection-title">{t('shop.models.title')}</Heading>
      <p>{t('shop.models.intro')}</p>
    </div>
    <ul class="collection__grid" role="list">
      {collection.map(({ id, name, photos, strap }) => (
        <li class="collection__model">
          <ProductGallery
            lang={lang}
            layout="collection"
            idPrefix={`collection-${id}`}
            photos={photos}
            altFor={(n) => t(n === 1 ? 'shop.models.front' : 'shop.models.interior', { model: name })}
          />
          <ModelHeading class="collection__name">{name}</ModelHeading>
          {strap && <p class="collection__strap">{t('shop.models.strap')}</p>}
          <p class="collection__price">CHF {formatPrice(55)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .collection {
    scroll-margin-top: var(--header-h);
  }

  .collection__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-4);
  }

  .collection__model {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    grid-template-rows: subgrid;
    grid-row: span 4;
    row-gap: var(--s-2);
    min-width: 0;
  }

  .collection__name {
    font-size: clamp(1.25rem, 3vw, 2rem);
    grid-row: 2;
  }

  .collection__strap {
    grid-row: 3;
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .collection__price {
    grid-row: 4;
    color: var(--c-plum);
    font-weight: 700;
  }

  @media (min-width: 64rem) {
    .collection__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--s-5);
    }
  }
</style>
