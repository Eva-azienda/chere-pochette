---
/**
 * The three official models (Jolie, Belle, Coquette) with their cut-out photos.
 * Each card links to the shop filtered on that model (/shop/#belle).
 * Phones: a horizontal row you can swipe; larger screens: three columns.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import jolie from '../assets/brand/model-jolie.png';
import belle from '../assets/brand/model-belle.png';
import coquette from '../assets/brand/model-coquette.png';
import { type Lang, useTranslations } from '../lib/i18n';
import { localePath } from '../lib/urls';
import { models } from '../lib/catalog';

interface Props {
  lang: Lang;
  headingLevel?: 3 | 4;
}

const { lang, headingLevel = 3 } = Astro.props;
const { t } = useTranslations(lang);
const Heading = `h${headingLevel}` as 'h3' | 'h4';

// models.json → "image": "model-belle" → the cut-out file in src/assets/brand/
const images: Record<string, ImageMetadata> = {
  'model-jolie': jolie,
  'model-belle': belle,
  'model-coquette': coquette,
};
const altKeys: Record<string, string> = {
  'model-jolie': 'images.modelJolie',
  'model-belle': 'images.modelBelle',
  'model-coquette': 'images.modelCoquette',
};
---

<ul role="list" class="models">
  {
    models.map((model) => (
      <li class="model">
        <a class="model__link" href={localePath(lang, `shop/#${model.id}`)}>
          <div class="model__media">
            {images[model.image] && (
              <Picture
                src={images[model.image]}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[320, 480, 720]}
                sizes="(min-width: 48rem) 30vw, 70vw"
                alt={altKeys[model.image] ? t(altKeys[model.image]) : model.name}
                loading="lazy"
              />
            )}
          </div>
          <Heading class="model__name">{model.name}</Heading>
          <p class="model__type">{model.type[lang]}</p>
          <span class="model__cta">{t('shop.models.viewModel', { model: model.name })}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .models {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 72%;
    gap: var(--s-4);
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-bottom: var(--s-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .models::-webkit-scrollbar {
    display: none;
  }

  .model {
    scroll-snap-align: start;
  }

  .model__link {
    display: grid;
    justify-items: center;
    gap: var(--s-1);
    text-align: center;
    color: inherit;
    text-decoration: none;
  }

  .model__media {
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: var(--s-3);
    overflow: hidden;
    border-radius: var(--radius-sm);
    /* Soft placeholder while the photo loads; the cut-outs are on the page ivory and cover it. */
    background: var(--placeholder);
  }

  .model__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 600ms var(--ease);
  }

  .model__link:hover .model__media :global(img) {
    transform: scale(1.04) rotate(-1deg);
  }

  .model__name {
    font-size: var(--fs-xl);
  }

  .model__type {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .model__cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-plum);
    text-decoration: underline;
    text-decoration-color: var(--c-line-strong);
    text-underline-offset: 0.25em;
  }

  .model__link:hover .model__cta {
    color: var(--c-bordeaux);
    text-decoration-color: currentColor;
  }

  @media (min-width: 48rem) {
    .models {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }
</style>
