---
/**
 * "Art direction": a portrait crop on phones and a landscape crop on larger screens,
 * in one <picture> (the browser downloads only the version it shows).
 *   <ArtPicture mobile={portrait45} desktop={landscape} alt="…" />
 * Screens from 48rem (768px) wide get the desktop (landscape) version.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  mobile: ImageMetadata;
  desktop: ImageMetadata;
  alt: string;
  /** sizes for each version (how wide the image is on screen). */
  mobileSizes?: string;
  desktopSizes?: string;
  mobilePosition?: string;
  desktopPosition?: string;
  class?: string;
}

const {
  mobile,
  desktop,
  alt,
  mobileSizes = '100vw',
  desktopSizes = '60vw',
  mobilePosition = '50% 50%',
  desktopPosition = '50% 50%',
  class: className,
} = Astro.props;

// From this width the landscape (desktop) version is shown. Keep in sync with the @media rule in <style>.
const media = '(min-width: 48rem)';
const FORMATS = ['avif', 'webp', 'jpg'] as const;
const mimeType = (format: (typeof FORMATS)[number]) => (format === 'jpg' ? 'image/jpeg' : `image/${format}`);

// Never ask for a width larger than the original file (Astro doesn't upscale).
const build = (src: ImageMetadata, widths: number[]) =>
  Promise.all(
    FORMATS.map(async (format) => ({
      format,
      image: await getImage({ src, widths: widths.filter((w) => w <= src.width), format }),
    })),
  );

const [mobileSets, desktopSets] = await Promise.all([
  build(mobile, [400, 640, 828, 1080, 1440]),
  build(desktop, [768, 1080, 1440, 1920, 2400]),
]);
const fallback = mobileSets.find((s) => s.format === 'jpg')!.image;
---

<picture class:list={['art', className]} style={`--pos-m: ${mobilePosition}; --pos-d: ${desktopPosition}`}>
  {
    desktopSets.map(({ format, image }) => (
      <source
        media={media}
        type={mimeType(format)}
        srcset={image.srcSet.attribute}
        sizes={desktopSizes}
        width={desktop.width}
        height={desktop.height}
      />
    ))
  }
  {
    mobileSets
      .filter((s) => s.format !== 'jpg')
      .map(({ format, image }) => (
        <source type={mimeType(format)} srcset={image.srcSet.attribute} sizes={mobileSizes} />
      ))
  }
  <img
    src={fallback.src}
    srcset={fallback.srcSet.attribute}
    sizes={mobileSizes}
    width={mobile.width}
    height={mobile.height}
    alt={alt}
    loading="lazy"
    decoding="async"
  />
</picture>

<style>
  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos-m);
  }

  @media (min-width: 48rem) {
    .art img {
      object-position: var(--pos-d);
    }
  }
</style>
