---
import BrandPicture from './BrandPicture.astro';
import { useTranslations, type Lang } from '../lib/i18n';
import jolieDetail from '../assets/brand/carousel/jolie-detail.webp';
import belleDetail from '../assets/brand/carousel/belle-detail.webp';
import belleGoldenHall from '../assets/brand/carousel/belle-sala-dorata.webp';
import coquetteLeaves from '../assets/brand/carousel/coquette-leaves.webp';
import bellePark from '../assets/brand/carousel/belle-park.webp';
import essentielleBench from '../assets/brand/carousel/essentielle-bench.webp';
import jolieEiffelTower from '../assets/brand/carousel/jolie-torre-eiffel.webp';
import joliePark from '../assets/brand/carousel/jolie-park.webp';
import coquetteCoral from '../assets/brand/carousel/coquette-coral.webp';

interface Props { lang: Lang }

const { t } = useTranslations(Astro.props.lang);
const slides = [
  { image: jolieDetail, alt: 'jolieDetail', shape: 'wide', position: '51% 55%' },
  { image: belleDetail, alt: 'belleDetail', shape: 'portrait' },
  { image: belleGoldenHall, alt: 'belleGoldenHall', shape: 'portrait', position: '50% 60%' },
  { image: coquetteLeaves, alt: 'coquetteLeaves', shape: 'wide', position: '50% 50%' },
  { image: bellePark, alt: 'bellePark', shape: 'standard', position: '42% 50%' },
  { image: essentielleBench, alt: 'essentielleBench', shape: 'wide', position: '48% 50%' },
  { image: jolieEiffelTower, alt: 'jolieEiffelTower', shape: 'tall' },
  { image: joliePark, alt: 'joliePark', shape: 'wide', position: '58% 50%' },
  { image: coquetteCoral, alt: 'coquetteCoral', shape: 'wide', position: '45% 50%' },
];
---

<section id="carosello" class="home-carousel" aria-label={t('home.carousel.label')} data-home-carousel>
  <ol class="carousel-track" id="home-carousel-track" tabindex="0">
    {slides.map(({ image, alt, shape, position }) => (
      <li class="carousel-slide" data-shape={shape}>
        <BrandPicture
          src={image}
          alt={t('images.homeCarousel.' + alt)}
          sizes={shape === 'tall' ? '(min-width: 48rem) 14rem, 8rem' : shape === 'portrait' ? '(min-width: 48rem) 19rem, 10rem' : '(min-width: 72rem) 32rem, (min-width: 48rem) 45vw, 77vw'}
          widths={[480, 768, 864, 1080, 1440]}
          position={position}
        />
      </li>
    ))}
  </ol>
  <div class="carousel-controls" hidden>
    <button type="button" aria-controls="home-carousel-track" data-toggle
      data-play-label={t('home.carousel.play')} data-pause-label={t('home.carousel.pause')}>
      <span aria-hidden="true"></span>
    </button>
  </div>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-home-carousel]');
  if (carousel) {
    const track = carousel.querySelector<HTMLOListElement>('.carousel-track')!;
    const controls = carousel.querySelector<HTMLElement>('.carousel-controls')!;
    const toggle = controls.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const symbol = toggle.querySelector('span')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const speed = 42; // CSS pixels per second
    let rotating = !motion.matches;
    let inView = false;
    let hovering = false;
    let frame = 0;
    let previousTime = 0;
    let position = track.scrollLeft;

    const advance = (time: number) => {
      const elapsed = previousTime ? Math.min(time - previousTime, 50) : 0;
      previousTime = time;
      position += speed * elapsed / 1000;

      // Move the first card only once it has left the viewport. The next card
      // keeps exactly the same screen position, including the gap between it and the first.
      const next = track.children[1] as HTMLElement;
      if (position >= next.offsetLeft) {
        position -= next.offsetLeft;
        track.append(track.firstElementChild!);
      }

      track.scrollLeft = position;
      frame = requestAnimationFrame(advance);
    };

    const syncMotion = () => {
      const moving = rotating && inView && !hovering && !document.hidden;
      if (moving && !frame) {
        position = track.scrollLeft;
        previousTime = 0;
        frame = requestAnimationFrame(advance);
      } else if (!moving && frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }
    };

    const setRotation = (enabled: boolean) => {
      rotating = enabled;
      toggle.setAttribute('aria-label', (enabled ? toggle.dataset.pauseLabel : toggle.dataset.playLabel)!);
      symbol.textContent = enabled ? 'Ⅱ' : '▶';
      syncMotion();
    };
    const stop = () => setRotation(false);

    setRotation(rotating);
    controls.hidden = false;
    toggle.addEventListener('click', () => setRotation(!rotating));
    motion.addEventListener('change', (event) => { if (event.matches) stop(); });
    track.addEventListener('focusin', stop);
    track.addEventListener('pointerdown', stop);
    track.addEventListener('wheel', (event) => {
      if (event.deltaX || event.shiftKey) stop();
    }, { passive: true });
    track.addEventListener('pointerenter', (event) => {
      hovering = event.pointerType === 'mouse';
      syncMotion();
    });
    track.addEventListener('pointerleave', () => {
      hovering = false;
      syncMotion();
    });
    track.addEventListener('keydown', (event) => {
      if (event.target !== track || (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')) return;
      event.preventDefault();
      track.scrollBy({
        left: track.clientWidth * 0.7 * (event.key === 'ArrowLeft' ? -1 : 1),
        behavior: motion.matches ? 'instant' : 'smooth',
      });
    });

    document.addEventListener('visibilitychange', syncMotion);
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      syncMotion();
    }).observe(track);
  }
</script>

<style>
  .home-carousel {
    --media-height: clamp(13rem, 34vw, 24rem);
    --media-gap: clamp(0.375rem, 0.7vw, 0.625rem);
    width: 100%;
    min-width: 0;
    margin-top: var(--s-2);
  }

  .carousel-track {
    position: relative;
    display: flex;
    gap: var(--media-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overflow-anchor: none;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--c-line-strong) transparent;
  }

  .home-carousel:has(.carousel-controls:not([hidden])) .carousel-track {
    scrollbar-width: none;
  }

  .carousel-slide {
    height: var(--media-height);
    flex: none;
    width: min(77%, calc(var(--media-height) * 1.3333));
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--c-ivory-2);
  }

  [data-shape='standard'] { width: min(77%, calc(var(--media-height) * 1.15)); }
  [data-shape='portrait'] { width: calc(var(--media-height) * 0.75); }
  [data-shape='tall'] { width: calc(var(--media-height) * 9 / 16); }

  .carousel-slide :global(picture),
  .carousel-slide :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .carousel-slide :global(img) { object-fit: cover; }

  .carousel-controls:not([hidden]) {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--s-1);
  }

  .carousel-controls button {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--c-plum);
    cursor: pointer;
  }

  .carousel-controls button:hover {
    background: var(--c-powder-2);
    border-color: var(--c-plum);
  }
</style>
