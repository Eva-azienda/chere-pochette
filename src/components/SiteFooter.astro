---
/**
 * Footer on dark plum, kept light: logo + one line about us, e-mail / Instagram / languages,
 * and a thin bottom bar with © · YES and the legal links. No page links: they are in the
 * header menu (on phones they wrapped onto several lines).
 * (No newsletter for now — NewsletterForm.astro stays in the project for later.)
 */
import { Image } from 'astro:assets';
import logoIvory from '../assets/brand/logo-ivory.png';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { type Lang, useTranslations } from '../lib/i18n';
import { localePath } from '../lib/urls';
import { site } from '../lib/catalog';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const { t } = useTranslations(lang);
const year = new Date().getFullYear();
const legal = ['impressum', 'privacy', 'terms'] as const;
---

<footer class="footer on-dark">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href={localePath(lang)} class="footer__logo">
        <Image src={logoIvory} widths={[136, 272, 408]} sizes="136px" alt={t('a11y.homeLink')} loading="lazy" />
      </a>
      <p>{t('footer.about')}</p>
    </div>

    <div class="footer__meta">
      <ul role="list" class="footer__contact" aria-label={t('footer.contactTitle')}>
        <li>
          <a href={`mailto:${site.email}`}>
            <Icon name="mail" size={18} />
            <span>{site.email}</span>
          </a>
        </li>
        <li>
          <a href={site.instagram} rel="noopener">
            <Icon name="instagram" size={18} />
            <span>{t('common.instagram')}</span>
          </a>
        </li>
      </ul>
      <LanguageSwitcher lang={lang} path={path} variant="links" dots class="footer__lang" />
    </div>

    <div class="footer__bottom">
      <p>{t('footer.copyright', { year })} · {t('footer.yes')}</p>
      <ul role="list" class="footer__legal">
        {
          legal.map((id) => (
            <li>
              <a href={localePath(lang, `legal/#${id}`)}>{t(`legal.toc.${id}`)}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    padding-top: var(--s-6);
    padding-bottom: max(var(--s-5), env(safe-area-inset-bottom));
    background: var(--c-plum);
    color: var(--c-ivory);
    font-size: var(--fs-sm);
    /* language switcher colours on the dark background */
    --lang-color: color-mix(in srgb, var(--c-ivory) 70%, transparent);
    --lang-active: var(--c-ivory);
  }

  .footer a {
    color: var(--c-ivory);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--c-powder);
    text-decoration: underline;
  }

  .footer__inner {
    display: grid;
    gap: var(--s-5);
  }

  /* Logo + one sentence */
  .footer__brand {
    display: grid;
    gap: var(--s-3);
    max-width: 22rem;
  }

  .footer__logo {
    display: block;
    width: 136px;
  }

  .footer__brand p {
    opacity: 0.8;
  }

  /* One row of links that wraps; each link keeps a 48px tap height on touch screens. */
  .footer__contact,
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-5);
  }

  .footer__contact a,
  .footer__legal a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    overflow-wrap: anywhere;
  }

  /* E-mail · Instagram on the left, languages on the right */
  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
  }

  .footer :global(.footer__lang) {
    margin-left: calc(var(--s-3) * -1); /* line the first code up with the links */
  }

  /* Thin bottom bar */
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--s-5);
    padding-top: var(--s-3);
    border-top: 1px solid color-mix(in srgb, var(--c-ivory) 18%, transparent);
    font-size: var(--fs-xs);
  }

  .footer__bottom p {
    opacity: 0.75;
  }

  .footer__legal {
    column-gap: var(--s-4);
  }

  .footer__legal a {
    opacity: 0.85;
  }

  /* Desktop: languages flush right */
  @media (min-width: 64rem) {
    .footer :global(.footer__lang) {
      margin-left: 0;
      margin-right: calc(var(--s-3) * -1);
    }
  }

  /* Mouse and trackpad: links can sit closer together (still above the 24px minimum). */
  @media (pointer: fine) {
    .footer__contact a,
    .footer__legal a {
      min-height: 2.25rem;
    }
  }
</style>
